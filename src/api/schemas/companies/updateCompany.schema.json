{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["statusCode", "message", "data"],
  "additionalProperties": false,

  "properties": {
    "statusCode": {
      "type": "number",
      "enum": [200]
    },

    "message": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },

    "data": {
      "type": "object",
      "required": [
        "id",
        "name",
        "slug",
        "createdAt",
        "updatedAt",
        "status"
      ],
      "additionalProperties": false,

      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive"]
        }
      }
    }
  }
}