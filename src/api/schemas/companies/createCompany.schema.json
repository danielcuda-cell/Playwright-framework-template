{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["statusCode", "message", "data"],
  "properties": {
    "statusCode": {
      "type": "number",
      "enum": [201]
    },
    "message": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "data": {
      "type": "object",
      "required": [
        "id",
        "name",
        "slug",
        "createdAt",
        "updatedAt",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": ["active"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}